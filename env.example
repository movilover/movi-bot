# ===== আবশ্যক =====
BOT_TOKEN=123456:ABC-your-bot-token

# ===== বড় ফাইল (৪০০MB–১GB+) স্ট্রিমের জন্য — MTProto মোড =====
# https://my.telegram.org → API development tools থেকে নিন
API_ID=
API_HASH=
# ভিডিও যে চ্যানেলে আছে (বট ওই চ্যানেলের অ্যাডমিন হতে হবে). পাবলিক হলে @username দিন
CHAT_ID=@your_channel_username

# ===== ঐচ্ছিক =====
# শুধু আপনার নিজের Local Bot API সার্ভার থাকলে (telegram-bot-api --local). না থাকলে খালি রাখুন
BOT_API_BASE=https://api.telegram.org
# কোন সাইট থেকে ভিডিও চলবে (কমা দিয়ে). খালি = সবখান থেকে
ALLOWED_ORIGINS=https://your-site.com
PORT=3000
